# AI Coupon Finder — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Keys are loaded automatically on app start (python-dotenv).
# No restart needed after saving .env — just reload the page.
#
# ─────────────────────────────────────────────────────────────────
# 1. OPENROUTER — AI reasoning layer (picks best coupon with Mistral-7B)
#    FREE — no credit card required for the free model tier
#    Sign up : https://openrouter.ai/
#    Get key : https://openrouter.ai/keys  (click "Create Key")
#    Model used: mistralai/mistral-7b-instruct:free  (always free)
# ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_key_here

# ─────────────────────────────────────────────────────────────────
# 2. CouponAPI.org — 350k+ coupons from all affiliate networks worldwide
#    Free 7-day trial, no card required
#    Sign up: https://couponapi.org/account/register.php
#    After login → My Account → API Key
# ─────────────────────────────────────────────────────────────────
COUPONAPI_KEY=

# ─────────────────────────────────────────────────────────────────
# 3. Coupomated — India-focused affiliate coupon feed
#    Best for: Flipkart, Amazon IN, Myntra, Nykaa, Swiggy, Zomato
#    Free 14-day trial, no card required
#    Sign up: https://www.coupomated.com → Dashboard → API → Token
# ─────────────────────────────────────────────────────────────────
COUPOMATED_KEY=

# ─────────────────────────────────────────────────────────────────
# 4. RapidAPI — Marketplace with multiple coupon APIs (freemium)
#    Sign up: https://rapidapi.com → search "coupon" → subscribe free tier
# ─────────────────────────────────────────────────────────────────
RAPIDAPI_KEY=
RAPIDAPI_COUPON_HOST=
